{
  "description": "Review Radar: warn when a commit adds test gaming",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.mjs", "hook", "pre-commit"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
